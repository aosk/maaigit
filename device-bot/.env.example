# Copy this file to .env and fill it in. Never share .env.
MAAI_URL=https://your-maai.onrender.com
MAAI_BOT_KEY=maai_paste_the_key_from_the_admin_page
# Optional: Grok carries out the tasks you approve in MAAI (answers in text; it never runs commands on the device).
XAI_API_KEY=
# Optional: a specific Grok model; leave it out and the bot picks the newest one your key can use.
# GROK_MODEL=
# Minutes between deliveries to MAAI (the fixed note goes out at delivery, so a shorter wait answers people sooner).
SYNC_MINUTES=60
# Optional: the browser to use. Found by itself (Chrome, then Edge); set it only if it is somewhere else.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional: the only folders the bot may open or send you files from (each one approved in MAAI), separated by ";".
# Left out: Documents, Desktop and Downloads. Programs and scripts are never opened.
# ALLOWED_FOLDERS=C:\Users\you\Documents;C:\Users\you\Desktop
# Windows: the bot starts by itself when you sign in. Set to off to stop that.
# START_WITH_WINDOWS=off
# Optional: your WhatsApp number (e.g. 9665XXXXXXXX). With it, linking needs no QR: MAAI shows an 8-letter code
# to type in WhatsApp → Linked devices → Link with phone number instead. Learned by itself after the first link.
# MY_PHONE=
