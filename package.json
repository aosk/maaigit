{
  "name": "maai",
  "private": true,
  "version": "0.1.0",
  "description": "MAAI (Musaed Abdulrahman AI): a bilingual personal assistant that plans your day, books meetings, sets reminders and drafts replies, always asking before it acts.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./data/** server/index.ts",
    "phone": "tsx watch --clear-screen=false --ignore ./data/** server/index.ts --phone",
    "build": "vite build",
    "start": "vite build && cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "adhan": "^4.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
