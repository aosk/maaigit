{
  "name": "maai",
  "private": true,
  "version": "0.1.0",
  "description": "MAAI (Musaed Abdulrahman AI): a bilingual personal assistant that plans your day, books meetings, sets reminders and drafts replies, always asking before it acts.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./data/** server/index.ts",
    "phone": "tsx watch --clear-screen=false --ignore ./data/** server/index.ts --phone",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --online",
    "serve": "tsx server/index.ts --online",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run server/security",
    "unused": "knip --no-progress",
    "audit:deps": "npm audit --omit=dev",
    "check": "npm run typecheck && npm run lint && npm test && npm run unused && npm run audit:deps",
    "coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "adhan": "^4.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.38",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.1.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^5.88.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
