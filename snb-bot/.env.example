# Copy this file to .env (same folder) and fill it in. Never share it or put it in chat.
# The key and signing secret come from maai: StockSmart → Limits and settings → Connect the SNB bot (shown once).
STOCKSMART_URL=https://maaigit.onrender.com
STOCKSMART_KEY=stk_...
STOCKSMART_SECRET=...

# Practice mode: does everything except place the order at SNB. Leave it on until you have watched it for a week.
SNB_BOT_PRACTICE=1
