# Copy this file to ".env" (same folder) and fill in your key.
# Get a key at https://console.anthropic.com -> API Keys.
# Without a key MAAI still runs, in demo mode with canned replies.
ANTHROPIC_API_KEY=

# Port the app runs on: http://localhost:5173
PORT=5173

# PIN phones must enter (npm run phone). Leave empty for a random one,
# shown in the terminal when MAAI starts.
MAAI_PIN=

# Used for prayer times. Defaults to Riyadh.
MAAI_LATITUDE=24.7136
MAAI_LONGITUDE=46.6753
MAAI_TIMEZONE=Asia/Riyadh

# Optional: send email from your own Gmail. Needs 2-Step Verification, then an
# App Password from https://myaccount.google.com/apppasswords (not your real password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The same App Password also lets MAAI read your inbox (read-only).
# MAAI_DEMO_INBOX=1 shows sample emails instead, to try the Email screen.

# Optional: show your Google Calendar (read-only). Google Calendar -> Settings ->
# your calendar -> Integrate calendar -> "Secret address in iCal format".
# Several calendars: separate the addresses with spaces. Keep it private.
GOOGLE_CALENDAR_ICS_URL=
