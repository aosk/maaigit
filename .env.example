# Copy this file to ".env" (same folder) and fill in your key.
# Get a key at https://console.anthropic.com -> API Keys.
# Without a key MAAI still runs, in demo mode with canned replies.
ANTHROPIC_API_KEY=

# Port the app runs on: http://localhost:5173
PORT=5173

# PIN phones must enter (npm run phone). Leave empty for a random one,
# shown in the terminal when MAAI starts.
MAAI_PIN=

# Used for prayer times. Defaults to Riyadh.
MAAI_LATITUDE=24.7136
MAAI_LONGITUDE=46.6753
MAAI_TIMEZONE=Asia/Riyadh

# Optional: send email from your own Gmail. Needs 2-Step Verification, then an
# App Password from https://myaccount.google.com/apppasswords (not your real password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The same App Password also lets MAAI read your inbox (read-only).
# MAAI_DEMO_INBOX=1 shows sample emails instead, to try the Email screen.

# Optional: how often (hours) everything is refreshed in the background. Default 3.
# MAAI_SYNC_HOURS=3

# Optional: show your calendars (read-only). Google Calendar -> Settings -> your calendar ->
# Integrate calendar -> "Secret address in iCal format"; an iPhone calendar shared as a public
# link (webcal://...) works too. Several: separate the addresses with spaces. Keep them private.
GOOGLE_CALENDAR_ICS_URL=

# Optional: write meetings you approve in MAAI into Google Calendar. A Google Cloud service account:
# paste the whole downloaded JSON key, and share your calendar with its email ("Make changes to events").
# Steps are in the README ("Write meetings into Google Calendar").
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_CALENDAR_ID=

# Optional: Asana. Profile picture -> My Settings -> Apps -> Developer apps -> Create new token.
ASANA_TOKEN=
